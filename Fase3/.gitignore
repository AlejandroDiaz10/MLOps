# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.env/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ============================================
# DVC - CRITICAL: Track .dvc files, ignore data
# ============================================
# Ignore actual data files
/data/raw/*
/data/interim/*
/data/processed/*
/data/external/*

# BUT allow .dvc tracking files (these go to git!)
!/data/raw/*.dvc
!/data/interim/*.dvc
!/data/processed/*.dvc
!/data/external/*.dvc

# Allow .gitignore in data folders
!/data/raw/.gitignore
!/data/interim/.gitignore
!/data/processed/.gitignore
!/data/external/.gitignore

# DVC cache and temp files
/data/.dvc/cache
/data/.dvc/tmp

# ============================================
# Machine Learning Artifacts
# ============================================
# Models (will be versioned in MLflow, not git)
/models/*.pkl
/models/*.joblib
/models/*.h5
/models/*.hdf5
/models/*.model
/models/*.ckpt
/models/*.onnx
/models/*.pb
/models/*.tflite

# Allow model metadata (optional)
!/models/*.json
!/models/.gitkeep

# MLflow local artifacts (if using local tracking)
/mlruns/
/mlartifacts/

# ============================================
# Reports and Visualizations
# ============================================
/reports/figures/*.png
/reports/figures/*.jpg
/reports/figures/*.pdf
!/reports/figures/.gitkeep

# ============================================
# Logs and Outputs
# ============================================
*.log
*.out
*.err
logs/
*.log.*

# ============================================
# Data formats (raw files)
# ============================================
*.tsv
*.csv
*.parquet
*.feather

# YAML files (EXCEPT dvc.yaml and config files)
# *.yml  # COMMENTED OUT - we need dvc.yaml!
# Instead, be specific:
/data/**/*.yml

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ============================================
# IDE specific files
# ============================================
.vscode/
.idea/
*.code-workspace

# ============================================
# OS generated files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Python Testing
# ============================================
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
.tox/

# ============================================
# Environment files
# ============================================
.env
.env.local
.env.*.local
*.env

# ============================================
# Docker
# ============================================
.dockerignore
docker-compose.override.yml

# ============================================
# AWS Credentials (NEVER commit these!)
# ============================================
.aws/
*.pem
*.key
credentials

# ============================================
# DVC Remote Cache (optional, depends on setup)
# ============================================
.dvc/tmp
.dvc/cache